########################################
# Copy this file to `.env` and fill in.
# Do NOT commit real secrets.
########################################

# ---------- Backend ----------
# Port to run the Express server on
PORT=3000

# Mongo connection string
DB_CONNECT=mongodb://localhost:27017/swiftride   # or your MongoDB Atlas URI

# JWT secret used for signing tokens
JWT_SECRET=YOUR_JWT_SECRET

# ---------- Frontend ----------
# Base URL for backend API (no trailing slash)
VITE_BASE_URL=http://localhost:3000             # or your deployed API, e.g. https://api.example.com

# Some pages may read this key; keep both for compatibility
VITE_API_URL=http://localhost:3000              # optional alias of VITE_BASE_URL

# Google Maps API key for @react-google-maps/api
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
